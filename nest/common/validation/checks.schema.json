{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validation checks of a module (validation by observation, nest/common/README.md)",
  "description": "<module>/validation/checks.json: the behaviours the dev/preprod traces must show. Read by template/scripts/validation-report.mjs (which validates every file against this schema) and, for the traces of the front, by ValidationCheckRegistry.",
  "type": "object",
  "required": [
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    }
  },
  "$defs": {
    "traceName": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "maxLength": 100
    },
    "check": {
      "type": "object",
      "required": [
        "id",
        "module",
        "title",
        "description",
        "scenario",
        "expect",
        "severity",
        "since"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/traceName",
          "description": "Unique across the project, prefixed by the module: `user.login.otp-required`."
        },
        "module": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Id of the module owning the file."
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1000,
          "description": "The rule being verified."
        },
        "scenario": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1000,
          "description": "How the case arises in real use (what a user or a job does)."
        },
        "expect": {
          "type": "object",
          "required": [
            "traces",
            "outcome"
          ],
          "additionalProperties": false,
          "properties": {
            "traces": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/traceName"
              },
              "description": "Trace names (`vtrace` check argument) evidencing the behaviour; any of them with `outcome` makes the check OBSERVED_OK, any of them with `violation` makes it VIOLATION."
            },
            "outcome": {
              "enum": [
                "ok",
                "info"
              ]
            }
          }
        },
        "mustNotHappen": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*(?::(?:ok|violation|info))?$",
            "maxLength": 110
          },
          "description": "`<trace>` or `<trace>:<outcome>`: one occurrence makes the check VIOLATION."
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "since": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Date the check was introduced (YYYY-MM-DD)."
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "back",
              "front"
            ]
          },
          "description": "Who emits its traces (default [\"back\"]). `front` allow-lists them on POST /api/v1/validation/trace; a trace name of a front check may not be used by a back-only check. A critical/high check is only proven (OBSERVED_OK) by back traces."
        },
        "preLogin": {
          "type": "boolean",
          "description": "Front traces sent before sign-in (unauthenticated route); requires `front` in `sources`."
        },
        "fields": {
          "anyOf": [
            {
              "type": "object",
              "maxProperties": 24,
              "propertyNames": {
                "pattern": "^[A-Za-z][A-Za-z0-9_]{0,47}$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/fieldType"
              }
            },
            {
              "const": "*"
            }
          ],
          "description": "Fields the traces of this check may carry (allow-list; any other field is dropped). Absent = no field. \"*\" = any simple field, only for a back-only check, with fieldsJustification."
        },
        "fieldsJustification": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300,
          "description": "Why \"*\" is acceptable (required with \"fields\": \"*\")."
        }
      }
    },
    "fieldType": {
      "anyOf": [
        {
          "enum": [
            "string",
            "number",
            "boolean",
            "id"
          ]
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9 ._:/-]{1,64}$"
          }
        }
      ],
      "description": "string (sanitized free text), number, boolean, id (always replaced by its keyed fingerprint), or a list of allowed string values (kept verbatim)."
    }
  }
}
