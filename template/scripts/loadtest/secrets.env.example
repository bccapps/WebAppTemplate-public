# Secrets of the load test — this file is git-ignored (.loadtest/). Never commit it, never paste it in a chat.
# Admin API token of the target environment (a technical admin user's token): creates/removes the test accounts.
LOADTEST_ADMIN_TOKEN=
# Prometheus basic auth (queryable server used for host and application health).
LOADTEST_PROM_USER=
LOADTEST_PROM_PASSWORD=
# Optional: monitoring connections (otherwise read from monitor.*.envFile of the config).
LOADTEST_PG_URL=
LOADTEST_REDIS_URL=
# Secret of the Cloudflare skip rule (header x-loadtest-key = this value) when the rule was added by hand.
# Not needed when `cloudflare allow` created the rule (it records its own secret).
LOADTEST_BYPASS_KEY=
# Cloudflare API token (Zone → Zone WAF → Edit) for `cloudflare allow|revoke`.
CLOUDFLARE_API_TOKEN=
