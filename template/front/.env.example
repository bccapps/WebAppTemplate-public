# =============================================================================
# front/.env — every variable read by the vx-public front (Vite) and the deploy-front script.
# Three sections, same order in every project:
#   1 Common — required · 2 Common — optional (template and module variables) · 3 App-specific (added below by <stack>/.env.example.local)
# Never put a secret in a VITE_* variable: they are inlined into the public bundle (the build warns about
# VITE_*TOKEN/SECRET/PASSWORD/PRIVATE values found in the output). Prowl keys and the TECH_TOKEN belong to back/.env.
# =============================================================================

# ===== 1. Common — required =====

# --- Identity (filled per project by scripts/create-project.sh) ---
PROJECT_NAME=
VITE_PROJECT_NAME=
VITE_PROJECT_DESCRIPTION=

# --- Network ---
VITE_FRONT_URL=http://localhost:5173
# VITE_API_URL can be either a relative path for docker/nginx deployment or a full URL for static direct deployment such as Cloudflare Pages
VITE_API_URL=/api/v1
# Back port the dev proxy targets (= NODE_PORT of back/.env)
VITE_API_PORT=3000
# Dev/preview server port
VITE_PORT=5173

# @module user
# --- Web3 auth (Reown / WalletConnect): only read with the user module ("user" in shared-modules.json) ---
# Either public project ID name is accepted; VITE_REOWN_PROJECT_ID takes precedence when both are set.
VITE_REOWN_PROJECT_ID=
# any | expected (expected: also set VITE_AUTH_EXPECTED_CHAIN_ID, section 2)
VITE_AUTH_CHAIN_POLICY=any
# @end

# ===== 2. Common — optional =====

# @module user
# --- Web3 auth extras (user module) ---
WALLET_CONNECT_ID=
#VITE_WEB3AUTH_CLIENT_ID=
#VITE_AUTH_CHAIN_POLICY=expected
#VITE_AUTH_EXPECTED_CHAIN_ID=1
# @end

# --- Third-party API keys — optional / feature-specific ---
VITE_BRAVE_API_KEY=

# --- Deployment (deploy-front.sh, Cloudflare Pages) ---
CLOUDFLARE_PAGES_PROJECT=
# Pages branch: production (main, default) or preview deployments
# CLOUDFLARE_PAGES_BRANCH=main
# Per-project Cloudflare credentials (else the global wrangler login is used); deploy only, never in a VITE_* variable
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
