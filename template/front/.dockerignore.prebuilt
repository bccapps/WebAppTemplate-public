#
# Whitelist context of Dockerfile.prebuilt (written as the staged front/.dockerignore by scripts/deploy-full.sh when
# the front was built locally): only the processed nginx.conf and dist reach the remote daemon, never src/, public/
# or the resolved .libs/.
*
!Dockerfile
!nginx.conf
!dist
