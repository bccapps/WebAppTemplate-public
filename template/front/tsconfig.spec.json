{
  // Type-checks the specs (`npm run typecheck:specs`): Vitest only transpiles them, and tsconfig.app.json leaves them
  // out of `tsc -b`. Same options as the app, specs included, nothing emitted.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "tsBuildInfoFile": null,
    // Same aliases as the app, plus the one of vitestConfig.ts: specs shared with the back import '@jest/globals'.
    "paths": { "@/*": ["./src/*"], "@jest/globals": ["./node_modules/vitest"] }
  },
  "include": ["src"],
  "exclude": ["src/sw.ts"]
}
