{
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "vite --mode dev",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "update:libs": "git submodule update --remote --merge .libs/vx-public .libs/vx-private && node .libs/apptemplate/scripts/link-shared.mjs front",
    "predev": "node .libs/apptemplate/scripts/link-shared.mjs front",
    "lint": "eslint .",
    "typecheck:specs": "node .libs/apptemplate/scripts/typecheck-specs.mjs front",
    "i18n:check": "node .libs/apptemplate/scripts/check-i18n.mjs --check",
    "i18n:audit": "node .libs/apptemplate/scripts/check-i18n.mjs",
    "preview": "vite preview",
    "postinstall": "if [ -f .libs/apptemplate/scripts/link-shared.mjs ]; then node .libs/apptemplate/scripts/link-shared.mjs front; fi",
    "prebuild": "node .libs/apptemplate/scripts/build-package.mjs front && node .libs/apptemplate/scripts/link-shared.mjs front"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^9",
    "@mui/material": "^9",
    "@tiptap/extension-color": "^3.27.3",
    "@tiptap/extension-image": "^3.27.3",
    "@tiptap/extension-text-align": "^3.27.3",
    "@tiptap/extension-text-style": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "axios": "^1.20.0",
    "chart.js": "^4.4.8",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-chart-financial": "^0.2.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "dompurify": "^3.4.17",
    "html-to-image": "^1.11.11",
    "lightweight-charts": "^5",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.3.0",
    "react-toastify": "^11.0.5",
    "@tiptap/core": "^3.30.5",
    "@tiptap/pm": "^3.30.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.1.2",
    "buffer": "^6.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "prosemirror-view": "^1.42.3",
    "@tiptap/core": "$@tiptap/core",
    "@tiptap/pm": "$@tiptap/pm"
  }
}
