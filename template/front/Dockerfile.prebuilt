#
# Prebuilt front Dockerfile — used by scripts/deploy-full.sh when the front was built locally (the usual path): it is
# copied over the staged front/Dockerfile with .dockerignore.prebuilt. nginx.conf already has ${NODE_PORT} substituted
# (no build ARG, no runtime envsubst). front/Dockerfile stays the full build (fallback, local Docker runs).
# Never copied into a project: every project deploys with this file.
FROM nginx:1.30-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY dist /usr/share/nginx/html
