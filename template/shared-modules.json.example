{
  "_doc": "Copy to <project-root>/shared-modules.json and keep ONLY the modules you use. Consumed by scripts/link-shared.mjs (run from back/ and front/), which symlinks each listed module into src/modules_shared/ (gitignored). Each module is resolved in .libs/vx-public/<nest|react>, then .libs/vx-private/<nest|react>, then the legacy .libs/nestcommon | .libs/reactcommon; a module found in both vx-public and vx-private is an error. Modules NOT listed are PRUNED. Listing 'user' activates user management (accounts, login); without it the app runs anonymously (admin protected by ADMIN_TOKEN). Note the LLM module naming is not yet unified across projects: pick ONE of 'llm' | 'llm-client' (+ 'llm-chat'/'llm-proxy' where split).",
  "_available": "See `ls .libs/vx-public/<nest|react>` and `ls .libs/vx-private/<nest|react>` (legacy layout: `ls .libs/nestcommon` | `ls .libs/reactcommon`).",
  "nestcommon": [
    "common",
    "database"
  ],
  "reactcommon": [
    "common"
  ]
}
