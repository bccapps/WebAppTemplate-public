{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "modules_shared/*/*.proto",
        "outDir": "dist"
      },
      {
        "include": "modules_shared/*/*/*.proto",
        "outDir": "dist"
      },
      {
        "include": "modules_shared/*/*/*/*.proto",
        "outDir": "dist"
      },
      {
        "include": "modules_shared/*/*/*/*/*.proto",
        "outDir": "dist"
      }
    ]
  }
}
