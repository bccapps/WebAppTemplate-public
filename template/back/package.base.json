{
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "env-cmd -f .env nest start",
    "start:dev": "env-cmd -f .env.dev nest start --watch",
    "start:debug": "env-cmd -f .env.dev nest start --debug --watch",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "i18n:check": "node .libs/apptemplate/scripts/check-i18n.mjs --check",
    "i18n:audit": "node .libs/apptemplate/scripts/check-i18n.mjs",
    "locales:sync": "node .libs/apptemplate/scripts/sync-common-locales.mjs",
    "prettier-format": "prettier --config .prettierrc 'src/**/*.ts' --write",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "postinstall": "if [ -f .libs/apptemplate/scripts/link-shared.mjs ]; then node .libs/apptemplate/scripts/link-shared.mjs back; fi",
    "prebuild": "node .libs/apptemplate/scripts/build-package.mjs back && node .libs/apptemplate/scripts/link-shared.mjs back",
    "prestart": "node .libs/apptemplate/scripts/link-shared.mjs back",
    "prestart:dev": "node .libs/apptemplate/scripts/link-shared.mjs back"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@base-org/account": "^2.5.10",
    "@nestjs/common": "^11.1.12",
    "@nestjs/core": "^11.1.12",
    "@nestjs/platform-express": "^11.1.12",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^11.2.5",
    "@nestjs/typeorm": "^11.0.0",
    "@types/compression": "^1.8.1",
    "axios": "^1.13.4",
    "bs58": "^6.0.0",
    "cacheable-lookup": "^7.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "compression": "^1.8.1",
    "elliptic": "^6.6.1",
    "env-cmd": "^10.1.0",
    "fast-xml-parser": "^5.11.1",
    "ioredis": "^5.10.1",
    "nodemailer": "^8.0.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.11.5",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.3.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^11.1.12",
    "@types/elliptic": "^6.4.18",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "globals": "^15.15.0",
    "typescript-eslint": "^8.24.1",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
