{
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "env-cmd -f .env nest start",
    "start:dev": "env-cmd -f .env.dev nest start --watch",
    "start:debug": "env-cmd -f .env.dev nest start --debug --watch",
    "start:prod": "node dist/main",
    "migrate": "npm run build && DOTENV_CONFIG_PATH=.env.dev NODE_OPTIONS='-r dotenv-expand/config -r dotenv/config' npx typeorm -d dist/config/Datasource.js migration:run",
    "migrate:prod": "npm run build && DOTENV_CONFIG_PATH=.env NODE_OPTIONS='-r dotenv-expand/config -r dotenv/config' npx typeorm -d dist/config/Datasource.js migration:run",
    "update:libs": "git submodule update --remote --merge .libs/vx-public .libs/vx-private && node .libs/apptemplate/scripts/link-shared.mjs back",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "i18n:check": "node .libs/apptemplate/scripts/check-i18n.mjs --check",
    "i18n:audit": "node .libs/apptemplate/scripts/check-i18n.mjs",
    "locales:sync": "node .libs/apptemplate/scripts/sync-common-locales.mjs",
    "db:check": "node .libs/apptemplate/scripts/db-portability-check.mjs",
    "prettier-format": "prettier --config .prettierrc 'src/**/*.ts' --write",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "postinstall": "if [ -f .libs/apptemplate/scripts/link-shared.mjs ]; then node .libs/apptemplate/scripts/link-shared.mjs back; fi",
    "prebuild": "node .libs/apptemplate/scripts/build-package.mjs back && node .libs/apptemplate/scripts/link-shared.mjs back",
    "prestart": "node .libs/apptemplate/scripts/link-shared.mjs back",
    "prestart:dev": "node .libs/apptemplate/scripts/link-shared.mjs back"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@base-org/account": "^2.5.10",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@types/compression": "^1.8.1",
    "axios": "^1.20.0",
    "bs58": "^6.0.0",
    "cacheable-lookup": "^7.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "env-cmd": "^11.0.0",
    "fast-xml-parser": "^5.11.1",
    "helmet": "^8.2.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.1.4",
    "pdfkit": "^0.20.2",
    "pg": "^8.11.5",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^23.0.0",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.58.0",
    "jest": "^30.5.2",
    "prettier": "^3.2.5",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "dotenv-expand": "^12.0.1"
  },
  "overrides": {
    "proxy-addr": "^2.0.8",
    "@nestjs/swagger": {
      "js-yaml": "^5.5.0"
    },
    "axios": "$axios"
  }
}
