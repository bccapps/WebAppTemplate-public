{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".*\\.sqlite-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "isolatedModules": true
      }
    ]
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1"
  },
  "setupFiles": [
    "<rootDir>/test/e2e-setup-sqlite.ts"
  ],
  "globalSetup": "<rootDir>/test/e2e-global-setup-sqlite.ts",
  "testTimeout": 20000,
  "forceExit": true,
  "testPathIgnorePatterns": [
    "/node_modules/",
    "/\\.libs/"
  ]
}
