# =============================================================================
# APP_ENV — identifiant d'environnement (recommandé)
# =============================================================================
# Nom court et unique par environnement (ex: prod, preprod, dev, staging).
# Distinct de NODE_ENV (mode Node) et de PROJECT_NAME (identique pour tous les
# environnements d'une même app). Sert de désambiguateur partout où plusieurs
# environnements peuvent partager un même compte fournisseur externe (ex:
# `nestcommon/user` l'utilise pour préfixer la référence de campagne Mailjet
# d'une communication — sans lui, deux environnements partageant un compte
# Mailjet peuvent fusionner des envois sans rapport dans la même campagne).
# APP_ENV=prod

# =============================================================================
# Project identity
# =============================================================================
# Human-readable app name. Used as a label in outbound Prowl push notifications
# and disk-space alerts (nestcommon/common: ProwlService, DiskAlertService,
# UserNotificationService, DiskAlertService). Falls back to "UnknownApp" if unset — always set it for a real project.
# PROJECT_NAME=myapp

# =============================================================================
# Networking — HTTP server & CORS (back/src/main.ts, nestcommon/common bootstrap)
# =============================================================================
# Port the NestJS HTTP server listens on. Also used to label the Prometheus
# instance identity (nestcommon/infra) and to build the default cTrader OAuth
# callback URL (nestcommon/usertradingplatform) when unset elsewhere.
# NODE_PORT=3000

# Used ONLY to build the default CORS allow-list below
# (`http://localhost:<FRONT_PORT>`) when CLIENT_ORIGINS itself is not set —
# has no other effect.
# FRONT_PORT=5173

# Comma-separated list of origins allowed by CORS. Falls back to
# `http://localhost:<FRONT_PORT>` when unset. Use "*" to allow any origin
# (this also disables credentialed requests).
# CLIENT_ORIGINS=http://localhost:5173
# Refused at startup when NODE_ENV=production: list your explicit front origin(s) instead.

# Address the HTTP server binds to. Default 0.0.0.0 (all interfaces, needed in Docker);
# use 127.0.0.1 to keep a local-only instance off the network (mandatory with LOCAL_TRUST=true).
# HOST=0.0.0.0

# Express "trust proxy": true | false | hop count | subnet name (e.g. loopback). Default 1 in production
# (one reverse proxy in front: nginx, load balancer), off otherwise. Needed for correct req.ip / throttling.
# TRUST_PROXY=1

# Comma-separated path fragments whose JSON body is also exposed as req.rawBody (webhook signature
# checks) and may be up to 50 MB. Every other route is limited to 5 MB. Default: /webhook
# RAW_BODY_PATHS=/webhook

# Directory of the built front (contains index.html); relative paths resolve against back/. Set it to serve the
# front from this server (desktop shell, single container): static files, SPA fallback for HTML GETs outside /api,
# index.html never cached, /assets/* immutable. Unset = the API only (the front is served by nginx or a host).
# SERVE_FRONT_DIR=../front/dist

# Version reported by GET /api/v1/health. Falls back to npm_package_version, then "unknown".
# APP_VERSION=

# File logging (back/src/fileLogger.ts, installed by main.ts): every console line is timestamped and also
# written to <LOG_DIR>/back-<day>.log with size-based rotation.
# LOG_TO_FILE=true
# LOG_DIR=./logs
# LOG_MAX_BYTES=52428800

# api | worker | both (default). Set to "worker" to run only background/cron
# processing with no HTTP server — used to scale the API and the worker
# independently (see BACK_REPLICAS in docker-compose*.yml).
# NODE_ROLE=both

# =============================================================================
# Crypt — REQUIRED at boot (modules_shared/common)
# =============================================================================
# CryptService (column-level encryption of sensitive DB fields) and
# CryptSessionService (end-to-end transport encryption, ECDH/P-256) are both
# UNCONDITIONALLY provided by CommonModule — the backend refuses to boot
# without the two keys below, even if you never use transport crypto
# (DISABLE_TRANSPORT_CRYPTO only skips the interceptor's logic at request
# time, it does not skip constructing CryptSessionService at boot).

# 32-byte key (base64 or hex) deriving the per-namespace column encryption
# key. Generate with: openssl rand -base64 32
# CRYPT_DB_MASTER_KEY=

# 32-byte P-256 private key (base64 or hex) for the transport-crypto ECDH
# handshake (x-crypt-session header). Generate with: openssl rand -base64 32
# CRYPT_SESSION_PRIVATE_KEY=

# Fixed salt mixed into the per-namespace column encryption key derivation.
# Optional — falls back to a built-in constant if unset (fine for dev; set a
# real value in prod so a leaked master key alone isn't enough to derive it).
# CRYPT_DB_DERIVATION_SALT=

# Transport-crypto session TTL in milliseconds. Optional, has an internal default.
# CRYPT_SESSION_TTL_MS=

# "true" makes EncryptedColumnTransformer throw on legacy/plaintext column
# values instead of tolerating them during a migration. Leave unset until
# every row has been migrated to the encrypted format.
# CRYPT_STRICT=false

# "true" disables the transport-crypto interceptor entirely (plain JSON over
# HTTPS instead of the extra E2E-encrypted envelope) — handy for local dev
# without reproducing the browser's crypto handshake.
# DISABLE_TRANSPORT_CRYPTO=true

# =============================================================================
# Redis — optional (graceful in-memory fallback when unset, with a warning)
# =============================================================================
# Used for cross-replica transport-crypto sessions and JWT revocation lists.
# Without it, each backend replica keeps its own in-memory state — fine for a
# single local dev instance, NOT fine once BACK_REPLICAS > 1.
# REDIS_URL=redis://localhost:6379

# @module !user
# =============================================================================
# Admin access when the app has NO user management ("user" absent from shared-modules.json)
# =============================================================================
# >= 32 random chars (e.g. `openssl rand -hex 32`). Empty = admin UI/API disabled. Ignored when "user" is linked.
ADMIN_TOKEN=
# Local trust mode, for a single-user local app: when true, requests coming from the loopback interface (socket
# address 127.0.0.1/::1, Host localhost/127.0.0.1/[::1] on NODE_PORT, Origin absent or local) are administrators
# without ADMIN_TOKEN. Any other request still needs the key. The back REFUSES TO START unless HOST is a loopback
# address (HOST=127.0.0.1). Never set it on a server. No effect when "user" is linked.
# LOCAL_TRUST=false
# @end

# @module user
# --- Only with the user module ("user" listed in shared-modules.json) --------
# Session JWT signing secret. Falls back to CRYPT_DB_MASTER_KEY if unset — at
# least one of the two is required (modules_shared/user: UserService).
# JWT_SECRET=

# Web3 auth (front side: VITE_REOWN_PROJECT_ID, VITE_AUTH_CHAIN_POLICY in front/.env).
# Wallet address seeded as the admin user on boot (modules_shared/user:
# UserSeederService).
# ADMIN_WALLET=

# Bearer token seeded as a "tech" service user (modules_shared/user:
# UserSeederService) — used for server-to-server calls and by the front's
# VITE_TECH_TOKEN. Rotate by changing this value and letting the seeder re-run.
# TECH_TOKEN=
# @end

# --- Deployment helpers (project-owned) ---------------------------------------
# API key seeded with the `admin` scope (same rotation contract as TECH_TOKEN:
# change the value, re-deploy) so deploy-full.sh's runner auto-provisioning hook
# can mint the colocated runner's token without manual handling. Opt-in: unset =
# manual pairing. Format `ac_live_` + ≥8 chars. Requires back-end support for the
# `BOOTSTRAP_API_KEY` variable (project-specific). Never commit a value.
# BOOTSTRAP_API_KEY=

# Runner auto-provisioning (deploy-full.sh hook) — opt-in. RUNNER_PROVISION=1 pairs
# the colocated runner after the back is healthy (create if missing, rotate only if
# offline or RUNNER_ROTATE=1/--rotate-runner). The hook itself is project-owned
# (RUNNER_PROVISION_HOOK, default ./runner/scripts/provision-hub-runner.sh); runners
# created manually are left alone.
# RUNNER_PROVISION=0
# RUNNER_PROVISION_NAME=myrunner

# @module infra
# =============================================================================
# Observability — optional
# =============================================================================
# Prometheus instance label (modules_shared/infra). Falls back to
# "<hostname>:<NODE_PORT>" if unset.
# INSTANCE_ID=

# Bearer token required to read the /metrics endpoint (modules_shared/infra).
# Unset = no auth on that endpoint — set it once metrics leave localhost.
# METRICS_TOKEN=
# @end

# =============================================================================
# Notifications — optional (Prowl push notifications, modules_shared/common)
# =============================================================================
# PROWL_API_KEY=
# PROWL_API_URL=https://api.prowlapp.com/publicapi

# =============================================================================
# Storage — optional
# =============================================================================
# Absolute path for images/CMS assets shared across replicas (modules_shared/
# common, modules_shared/cms). Falls back to a local folder if unset — fine
# for a single instance, NOT fine once BACK_REPLICAS > 1 without a shared
# volume/mount.
# SHARED_DIRECTORY=

# @module database
# =============================================================================
# Multi-database connections — supplément documentaire (modules_shared/database)
# =============================================================================
# Ce fichier documente UNIQUEMENT le contrat d'environnement multi-DB fourni par
# le module partagé `modules_shared/database`. Les autres variables applicatives
# restent définies dans vos fichiers .env / .env.dev habituels.
#
# Bloc ci-dessous entièrement commenté => une seule connexion "main",
# comportement strictement identique à l'ancien Datasource mono-connexion.

# --- Connexion principale "main" (déjà présente dans votre .env) --------------
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=myapp
# DB_SSLMODE=disable            # disable | require | require-unauthorized | false/0/off (=disable)
# DB_SSLROOTCERT=               # chemin relatif au dossier back/
# DB_POOLSIZE=
# DATABASE_ENGINE=postgres      # postgres | cloud | neon | supabase | sqlite (DB_ENGINE a priorité)
# DB_PATH=data/app.db           # sqlite uniquement, relatif à back/ (voir README du module database)
# DB_MIGRATIONS_RUN=false       # true = exécute les migrations au démarrage (tous moteurs)
# TYPEORM_SYNC=true             # true/1 | false/0

# --- Connexions additionnelles (vide = socle dormant) ------------------------
# Liste des connexions nommées, séparées par des virgules :
# DB_CONNECTIONS=analytics
#
# Pour chaque connexion <NAME> (en MAJUSCULES), préfixe DB__<NAME>__ :
# DB__ANALYTICS__HOST=localhost
# DB__ANALYTICS__PORT=5432
# DB__ANALYTICS__USER=postgres
# DB__ANALYTICS__PASSWORD=
# DB__ANALYTICS__NAME=analytics
# DB__ANALYTICS__SSLMODE=disable
# DB__ANALYTICS__POOLSIZE=
# DB__ANALYTICS__ENGINE=postgres
# DB__ANALYTICS__PATH=          # sqlite uniquement
# DB__ANALYTICS__SYNC=true

# --- Routage module -> connexion ---------------------------------------------
# JSON { "moduleId": "connectionName" }. Un module absent reste sur "main".
# Contrainte : pas de relation/FK/transaction cross-DB.
# DB_MODULE_ROUTING={"token-trader":"analytics"}
# @end
