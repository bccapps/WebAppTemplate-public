# =============================================================================
# back/.env — every variable read by the vx-public back, the shared scripts and the compose files.
# Copy to back/.env (production), back/.env.preprod, back/.env.dev; leave commented what keeps its default.
# Sections: 1 Identity · 2 HTTP server · 3 Security · 4 Database · 5 Redis · 6 Storage & logs ·
#           7 Notifications · 8 Observability · 9 Desktop shell · 10 Deployment scripts
# Parts tied to a module (user, infra, database) only appear when that module is linked (create-project / add-module).
# =============================================================================

# =============================================================================
# 1. Identity & environment
# =============================================================================
# Short unique name of the environment (prod, preprod, dev, staging…). Disambiguates anything several environments share
# at an external provider (e.g. the Mailjet campaign reference of a `user` communication). Not NODE_ENV, not PROJECT_NAME.
# APP_ENV=prod

# App name, identical in every environment: label of push notifications and disk alerts, Docker/compose project name,
# image and volume names. Set it for a real project (falls back to "UnknownApp").
# PROJECT_NAME=myapp

# Node mode. The container image sets production; leave it unset in dev. Production refuses CORS "*", defaults
# TRUST_PROXY to 1, hides Swagger and turns the schema default to "no synchronize" (see DB_SCHEMA_MODE).
# NODE_ENV=production

# Version reported by GET /api/v1/health and used by the SQLite pre-update backup. Falls back to the package version.
# APP_VERSION=

# =============================================================================
# 2. HTTP server & CORS (back/src/main.ts, common bootstrap)
# =============================================================================
# NODE_PORT=3000                # port the back listens on (also the Prometheus instance label and the compose port mapping)
# HOST=0.0.0.0                  # bind address; 127.0.0.1 keeps an instance local-only (mandatory with LOCAL_TRUST=true)
# NODE_ROLE=all                # all | api | worker. all = one process doing API + background work (set by deploy-full.sh with BACK_WORKER=off); api = HTTP only; worker = background work only. Unset = worker behaviour. The compose files set it per service

# Comma-separated origins allowed by CORS; "*" allows any origin without credentials and is refused in production.
# Default: http://localhost:<FRONT_PORT>.
# CLIENT_ORIGINS=http://localhost:5173
# FRONT_PORT=5173               # only used to build the default CLIENT_ORIGINS (and by run.sh dev)

# TRUST_PROXY=1                 # Express "trust proxy": true | false | hop count | subnet name. Default 1 in production, off otherwise
# RAW_BODY_PATHS=/webhook       # path fragments whose body is also exposed as req.rawBody (webhook signatures, up to 50 MB; others 5 MB)
# SWAGGER_ENABLED=false         # Swagger UI on /api. Default: on outside production only
# SERVE_FRONT_DIR=../front/dist # serve the built front from this server (desktop shell, single container); unset = API only

# =============================================================================
# 3. Security
# =============================================================================
# --- Crypt: REQUIRED at boot (common) ---
# CryptService (column encryption) and CryptSessionService (end-to-end transport encryption, ECDH P-256) are always built:
# the back refuses to start without the two keys below. Generate each with: openssl rand -base64 32
# CRYPT_DB_MASTER_KEY=          # 32-byte key (base64 or hex) deriving the per-namespace column keys
# CRYPT_SESSION_PRIVATE_KEY=    # 32-byte P-256 private key (base64 or hex) of the transport handshake (x-crypt-session)
# CRYPT_DB_DERIVATION_SALT=     # salt of the column-key derivation; built-in constant if unset (fine in dev, set it in prod)
# CRYPT_SESSION_TTL_MS=         # transport session lifetime in ms (internal default)
# CRYPT_STRICT=false            # true = throw on plaintext/legacy column values instead of tolerating them (after migrating every row)
# DISABLE_TRANSPORT_CRYPTO=true # true = plain JSON over HTTPS, no E2E envelope (local dev without the browser handshake)

# @module !user
# --- Admin access when the app has NO user management ("user" not linked) ---
# >= 32 random chars (openssl rand -hex 32). Empty = admin UI/API disabled. Ignored when "user" is linked.
ADMIN_TOKEN=
# Single-user local app: requests from the loopback interface (socket 127.0.0.1/::1, Host localhost on NODE_PORT, Origin absent
# or local) are administrators without ADMIN_TOKEN. The back REFUSES TO START unless HOST is a loopback address. Never on a server.
# LOCAL_TRUST=false
# @end

# @module user
# --- Accounts & sessions (module "user") ---
# JWT_SECRET=                   # session JWT signing secret; falls back to CRYPT_DB_MASTER_KEY (one of the two is required)
# ADMIN_WALLET=                 # wallet address seeded as the admin user at boot (front: VITE_REOWN_PROJECT_ID, VITE_AUTH_CHAIN_POLICY)
# TECH_TOKEN=                   # LEGACY: static JWT of the remote data API, server-side fallback while REMOTE_API_KEY is unset; also seeds the local "tech" user. Never in front env
# @end

# --- Remote data API (modules *-remote: ChainTradingDataAPI) ---
# REMOTE_API_KEY=               # scoped api-access key of the remote API (X-API-Key; scopes tradingplatform:read, wallet-intelligence:read, data-ingestion:read); server-side only

# @module database
# =============================================================================
# 4. Database — engine, connection, schema, extra connections
# =============================================================================
# --- Engine & main connection ---
# DB_ENGINE=postgres            # postgres | cloud | neon | supabase | sqlite. The ONLY engine variable (DATABASE_ENGINE is refused)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=myapp
# DB_SSLMODE=disable            # disable | require | require-unauthorized | false/0/off (= disable)
# DB_SSLROOTCERT=               # CA certificate, path relative to back/
# DB_POOLSIZE=                  # max pooled connections
# DB_STATEMENT_TIMEOUT_MS=30000          # Postgres: cancel a query running longer than this (statement_timeout); 0 = no limit. Never applied to the typeorm CLI
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000 # Postgres: end a session idle inside an open transaction (idle_in_transaction_session_timeout); 0 = no limit

# --- SQLite only (DB_ENGINE=sqlite: no database container, the back opens the file) ---
# DB_PATH=data/app.db           # file: absolute, or relative to APP_DATA_DIR (else back/). Containers: the compose files set /data/<PROJECT_NAME>.db
# DB_BUSY_TIMEOUT_MS=5000       # wait for the single write lock before an error
# DB_BACKUP_REQUIRED=false      # true = refuse to start when the copy taken before a schema update fails (otherwise only logged)

# --- Schema management ---
# DB_SCHEMA_MODE=               # sync | migrations | manual — how tables are created and evolved at boot
#                               #   sync       = synchronize, no migrations (dev; SQLite apps without their own migrations)
#                               #   migrations = migrations loaded AND run at boot, no synchronize
#                               #   manual     = nothing at boot; run the migrations yourself (typeorm CLI, run.sh --migrate)
#                               # Empty = synchronize outside production (SQLite: always), nothing at boot in production.
#                               # The typeorm CLI ignores all of this: it loads the migrations and never synchronizes.
# DB_MIGRATIONS_RUN=false       # legacy flag, only read when DB_SCHEMA_MODE is empty: true = run the migrations at boot
# DB_SQLITE_MIGRATIONS=false    # legacy flag, SQLite only: the app ships its own SQLite migrations

# --- Diagnostics ---
# DB_PORTABLE_LOG=true          # false silences the one-line summary of the Postgres -> SQLite entity adaptation
# TYPEORM_CLI=                  # 1 = behave as the typeorm CLI (migrations loaded, never synchronize); `typeorm ...` is detected on its own

# --- Additional connections (empty = dormant, a single "main" connection) ---
# Comma-separated names; each one (UPPERCASE) uses the prefix DB__<NAME>__ with the same keys as the main connection:
# DB_CONNECTIONS=analytics
# DB__ANALYTICS__HOST=localhost
# DB__ANALYTICS__PORT=5432
# DB__ANALYTICS__USER=postgres
# DB__ANALYTICS__PASSWORD=
# DB__ANALYTICS__NAME=analytics
# DB__ANALYTICS__SSLMODE=disable
# DB__ANALYTICS__POOLSIZE=
# DB__ANALYTICS__ENGINE=postgres
# DB__ANALYTICS__PATH=          # sqlite only
# DB__ANALYTICS__SCHEMA_MODE=sync
# Module -> connection routing (JSON, a module not listed stays on "main"; no cross-database relation, FK or transaction):
# DB_MODULE_ROUTING={"token-trader":"analytics"}
# @end

# =============================================================================
# 5. Redis — optional (in-memory fallback with a warning when unset)
# =============================================================================
# Shared transport-crypto sessions and JWT revocation across replicas. Without it each replica keeps its own state:
# fine for one instance, NOT once BACK_REPLICAS > 1.
# REDIS_URL=redis://localhost:6379

# =============================================================================
# 6. Storage & logs
# =============================================================================
# Root of the app's writable data: default base of SHARED_DIRECTORY (<dir>/shared), LOG_DIR (<dir>/logs) and of a relative DB_PATH.
# Unset = back/ for DB_PATH, ./logs, tmp/shared. A desktop shell sets it to the OS application-data folder.
# APP_DATA_DIR=
# SHARED_DIRECTORY=             # absolute path of images/CMS assets shared across replicas; local folder if unset (not enough once BACK_REPLICAS > 1)

# Every console line is timestamped and also written to <LOG_DIR>/back-<day>.log with size-based rotation (back/src/fileLogger.ts).
# LOG_TO_FILE=true
# LOG_DIR=./logs                # default <APP_DATA_DIR>/logs when APP_DATA_DIR is set
# LOG_MAX_BYTES=52428800        # rotation threshold

# --- Scheduled jobs (common CronLockService.runExclusive) ---
# CRON_LEASE_TTL_MS=600000      # default lease of an exclusive job (renewed while it runs): how long a job stays blocked after its holder died

# =============================================================================
# 7. Notifications — optional (Prowl push, common)
# =============================================================================
# PROWL_API_KEY=
# PROWL_API_URL=https://api.prowlapp.com/publicapi

# @module infra
# =============================================================================
# 8. Observability — optional
# =============================================================================
# INSTANCE_ID=                  # Prometheus instance label (default <hostname>:<NODE_PORT>)
# METRICS_TOKEN=                # bearer token to read /metrics; unset = no auth (set it once metrics leave localhost)
# @end

# =============================================================================
# 9. Desktop shell (set by the shell, never by hand)
# =============================================================================
# DESKTOP_PARENT_PID=           # pid of the shell: the back exits when it disappears. See desktop/README.md

# =============================================================================
# 10. Deployment scripts (deploy-full.sh, run.sh, restart.sh, stop.sh, backup-db.sh…)
# =============================================================================
# --- Target hosts: required by deploy-full.sh (PROJECT_NAME above too) ---
# BACK_HOSTS=1.2.3.4            # comma-separated [user@]host entries running the back (REMOTE_HOST = a single host for back and front)
# FRONT_HOSTS=1.2.3.4           # comma-separated [user@]host entries running the front (not needed with a Cloudflare Pages front)
# REMOTE_USER=ubuntu            # default SSH user
# REMOTE_SSH_PORT=22
# SSH_KEY_FILE=~/.ssh/id_deploy # private key
# REMOTE_CONTEXT_NAME=myapp     # name of the Docker context created per host
# REMOTE_APP_DIR=~/myapp        # directory on the host (receives the staged compose project)
# Per-side overrides of the five keys above (back hosts / front hosts only; unset = the shared value):
# BACK_REMOTE_USER=
# BACK_SSH_PORT=
# BACK_SSH_KEY_FILE=
# BACK_CONTEXT_NAME=
# BACK_REMOTE_APP_DIR=
# FRONT_REMOTE_USER=
# FRONT_SSH_PORT=
# FRONT_SSH_KEY_FILE=
# FRONT_CONTEXT_NAME=
# FRONT_REMOTE_APP_DIR=

# --- Containers & build ---
# BACK_REPLICAS=1               # API replicas behind back-lb (1 with SQLite); the worker is always a single instance
# BACK_WORKER=on                # on | off (also true/false/1/0). off = no back-worker container: back runs alone with NODE_ROLE=all (API + background work). Only back manages the schema; the worker starts after back is healthy
# VITE_PORT=8080                # host port published for the front container
# INFRA_BIND=127.0.0.1          # address the database / Redis containers publish their port on (0.0.0.0 = reachable from outside)
# COMPOSE_FILE_NAME=            # compose file to deploy (default: docker-compose.yml for DB_ENGINE=postgres, docker-compose-cloud.yml otherwise)
# FORCE_REBUILD=0               # 1 = rebuild images without the layer cache
# KEEP_BUILD_CONTEXT=0          # 1 = keep the staged build context after the deploy (debugging)
# REDIS_HOST=                   # [user@]host of the Redis container: deployed with the back when it is the same host
# REDIS_PORT=6379
# REDIS_PASSWORD=               # also required by the Redis container (--requirepass)
# REDIS_MAXMEMORY=256mb         # Redis container memory cap
# REDIS_MAXMEMORY_POLICY=volatile-ttl   # evict only keys with a TTL, shortest first (keeps revocations and TTL-less state)

# --- Firewall (UFW rules applied on the hosts during the deploy; IP lists, empty = untouched) ---
# WHITELIST=                    # may reach VITE_PORT (front hosts) and NODE_PORT + DB_PORT (back hosts)
# BACK_WHITELIST=               # may reach NODE_PORT only
# PROXY_HOSTS=                  # reverse proxies: VITE_PORT on front hosts, NODE_PORT on back hosts

# --- Metrics push (vmagent container, started when a URL is set) ---
# PROMETHEUS_REMOTE_WRITE_URLS= # comma-separated remote-write URLs (PROMETHEUS_REMOTE_WRITE_URL, singular, still accepted)
# PROMETHEUS_BASIC_AUTH_USER=   # one value for all URLs, or one per URL (same count, comma-separated)
# PROMETHEUS_BASIC_AUTH_PASSWORD=

# --- Backups (backup-db.sh / restore-db.sh, PostgreSQL only) ---
# BACKUP_SCHEMAS=               # comma-separated schemas to dump (supabase defaults to public; empty = all)
# DB_DIRECT_HOST=               # supabase: direct (non-pooler) host used for the dump instead of db.<project-ref>.supabase.co

# --- Project-owned hooks (all opt-in: unset or missing = nothing happens) ---
# DEV_SERVICES_HOOK=./scripts-local/dev-services.sh     # extra local process started by run.sh dev after back + front
# BACK_BUILD_HOOK=./scripts-local/stage-runner-dist.sh  # receives the staged back build dir to add files to the image context
# RUNNER_PROVISION=0            # 1 = pair the colocated runner once the back is healthy (create if missing, rotate only if offline)
# RUNNER_PROVISION_HOOK=./runner/scripts/provision-hub-runner.sh
# RUNNER_PROVISION_NAME=myrunner
# RUNNER_ROTATE=0               # 1 (or --rotate-runner) = rotate the runner token even if the runner exists
# BOOTSTRAP_API_KEY=            # API key seeded with the `admin` scope (`ac_live_` + >= 8 chars) so the hook can mint the runner token; never commit a value
